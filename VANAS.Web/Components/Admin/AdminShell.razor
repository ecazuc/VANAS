@inject StaffAuthState Auth
@inject NavigationManager Navigation

<AuthorizeView Roles="Staff,Admin">
    <Authorized>
        <div class="admin">
            <aside class="admin-side">
                <a class="brand" href="/">VANAS</a>
                <span class="muted label">CONSOLE STAFF</span>
                <nav class="side-nav">
                    <NavLink href="/admin" Match="NavLinkMatch.All">Postes en direct</NavLink>
                    <NavLink href="/admin/comptes">Comptes</NavLink>
                    <NavLink href="/admin/caisse">Caisse</NavLink>
                    <NavLink href="/admin/tarifs">Tarifs</NavLink>
                    <NavLink href="/admin/blog">Blog</NavLink>
                    <NavLink href="/admin/evenements">Événements</NavLink>
                    <NavLink href="/admin/jeux">Jeux</NavLink>
                </nav>
                <div class="side-foot">
                    <span class="muted">@Auth.Username (@Auth.Role)</span>
                    <button class="btn small" @onclick="SignOutAsync">Déconnexion</button>
                </div>
            </aside>
            <section class="admin-main">
                <h1>@Title</h1>
                @ChildContent
            </section>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
    <Authorizing>
        <p class="muted center">Chargement...</p>
    </Authorizing>
</AuthorizeView>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/admin/login");
    }
}
