@page "/admin"
@layout Layout.AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiClient Api
@inject StaffAuthState Auth

<PageTitle>Postes - VANAS staff</PageTitle>

<AdminShell Title="Postes en direct">
    <AutoRefresh OnTick="LoadAsync" />
    <p class="muted">
        @_stations.Count(s => s.IsInUse) en jeu sur @_stations.Count poste(s) connus. Mise à jour toutes les 5 secondes.
    </p>

    @if (_message != null)
    {
        <p class="msg @(_messageIsError ? "error" : "ok")">@_message</p>
    }

    @if (_stations.Count == 0)
    {
        <p class="muted">Aucun poste n'a encore démarré de session.</p>
    }

    <div class="station-grid">
        @foreach (var s in _stations)
        {
            <article class="card station @(s.IsInUse ? "in-use" : "free")">
                <header>
                    <strong>@s.Name</strong>
                    <span class="chip @(s.IsInUse ? "chip-on" : "chip-off")">@(s.IsInUse ? "EN JEU" : "LIBRE")</span>
                </header>
                @if (s.IsInUse)
                {
                    <p class="big">@s.Username</p>
                    <p>Temps restant : <strong>@Format.Minutes(s.MinutesLeft ?? 0)</strong></p>
                    <p class="muted">Depuis @(s.SessionStartedAt?.ToLocalTime().ToString("HH:mm"))</p>
                    <button class="btn small danger" @onclick="() => KickAsync(s)">Kicker</button>
                }
                else
                {
                    <p class="muted">Dernière activité : @s.LastSeenAt.ToLocalTime().ToString("dd/MM HH:mm")</p>
                }
            </article>
        }
    </div>
</AdminShell>

@code {
    private List<StationStatus> _stations = new();
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Auth.Token == null) return;
        var result = await Api.GetStationsAsync();
        if (result.Ok && result.Value != null)
        {
            _stations = result.Value;
            if (_messageIsError) _message = null;
        }
        else
        {
            _message = result.Error;
            _messageIsError = true;
        }
    }

    private async Task KickAsync(StationStatus station)
    {
        if (station.UserId is not int id) return;
        var result = await Api.KickAsync(id);
        _messageIsError = !result.Ok;
        _message = result.Ok ? $"{station.Username} est déconnecté." : result.Error;
        await LoadAsync();
    }

}
