<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VANAS.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:VANAS.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="#16181C"
    Shell.TabBarBackgroundColor="#23262D"
    Shell.TabBarTitleColor="#FCEE0A"
    Shell.TabBarUnselectedColor="#7C828F"
    Title="VANAS">

    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />

    <TabBar Route="main">
        <ShellContent Title="Accueil" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Événements" Route="events" ContentTemplate="{DataTemplate pages:EventsPage}" />
        <ShellContent Title="Messages" Route="messages" ContentTemplate="{DataTemplate pages:MessagesPage}" />
        <ShellContent x:Name="ScanTab" Title="Scanner" Route="scan" IsVisible="False" ContentTemplate="{DataTemplate pages:ScanPage}" />
    </TabBar>

</Shell>
