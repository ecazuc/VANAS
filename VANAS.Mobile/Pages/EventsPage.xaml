<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VANAS.Mobile.Pages.EventsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181C">
    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="#FCEE0A">
        <ScrollView>
            <VerticalStackLayout Padding="24,48,24,24" Spacing="12" MaximumWidthRequest="460">
                <Label Text="ÉVÉNEMENTS" FontSize="28" FontAttributes="Bold" TextColor="#FCEE0A" />
                <Label Text="Tournois et soirées au café. Touchez un événement pour réserver votre place." FontSize="12" TextColor="#7C828F" />

                <Label x:Name="ErrorLabel" TextColor="#FF4D5E" IsVisible="False" />
                <Label x:Name="EmptyLabel" Text="Aucun événement prévu pour l'instant." TextColor="#7C828F" IsVisible="False" />
                <VerticalStackLayout x:Name="ListBox" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
