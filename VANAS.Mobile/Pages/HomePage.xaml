<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VANAS.Mobile.Pages.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181C">
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="14" MaximumWidthRequest="460">
            <Label Text="VANAS" FontSize="28" FontAttributes="Bold" TextColor="#FCEE0A" />

            <Border x:Name="ConsentBox" IsVisible="False" BackgroundColor="#3A3200" Stroke="#FCEE0A" StrokeThickness="1" Padding="14">
                <Label Text="Accord parental requis : un parent ou responsable légal doit passer au comptoir du café pour valider votre inscription avant que vous puissiez jouer ou utiliser la messagerie." TextColor="#FCEE0A" FontSize="13" />
            </Border>

            <Border x:Name="WarningBox" IsVisible="False" BackgroundColor="#3A1D22" Stroke="#FF4D5E" StrokeThickness="1" Padding="14">
                <Label x:Name="WarningLabel" TextColor="#FF4D5E" FontAttributes="Bold" />
            </Border>

            <Border BackgroundColor="#23262D" Stroke="#FCEE0A" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="BIENVENUE" FontSize="11" TextColor="#7C828F" />
                    <Label x:Name="NameLabel" Text="..." FontSize="24" FontAttributes="Bold" TextColor="#C8CCD4" />
                    <Label x:Name="AccountLabel" FontSize="12" TextColor="#7C828F" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#23262D" Stroke="#2E323B" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="TEMPS RESTANT" FontSize="11" TextColor="#7C828F" VerticalOptions="Center" />
                        <Label x:Name="StateLabel" FontSize="11" FontAttributes="Bold" TextColor="#7C828F" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label x:Name="TimeLabel" Text="--" FontSize="40" FontAttributes="Bold" TextColor="#FCEE0A" />
                    <Label x:Name="PassLabel" FontSize="12" FontAttributes="Bold" TextColor="#3DF2A5" IsVisible="False" />
                    <Label x:Name="LinkLabel" FontSize="12" TextColor="#7C828F" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#23262D" Stroke="#2E323B" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="TEMPS JOUÉ" FontSize="11" TextColor="#7C828F" />
                    <Label x:Name="PlayedLabel" Text="--" FontSize="22" FontAttributes="Bold" TextColor="#C8CCD4" />
                    <Label x:Name="SessionsLabel" FontSize="12" TextColor="#7C828F" />
                </VerticalStackLayout>
            </Border>

            <Label Text="DERNIÈRES SESSIONS" FontSize="11" TextColor="#7C828F" Margin="0,8,0,0" />
            <VerticalStackLayout x:Name="HistoryBox" Spacing="6" />
            <Label x:Name="NoHistoryLabel" Text="Aucune session pour l'instant." FontSize="12" TextColor="#7C828F" IsVisible="False" />

            <Label x:Name="ErrorLabel" TextColor="#FF4D5E" IsVisible="False" />

            <Label Text="MES DONNÉES" FontSize="11" TextColor="#7C828F" Margin="0,12,0,0" />
            <Button Text="TÉLÉCHARGER MES DONNÉES" BackgroundColor="#2E323B" TextColor="#C8CCD4" CornerRadius="0" Clicked="OnExport" />
            <Button Text="SUPPRIMER MON COMPTE" BackgroundColor="Transparent" TextColor="#7C828F" FontSize="12" Clicked="OnDeleteAccount" />

            <Button Text="SE DÉCONNECTER" BackgroundColor="Transparent" TextColor="#FF4D5E" BorderColor="#FF4D5E" BorderWidth="1" CornerRadius="0" Clicked="OnSignOut" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
