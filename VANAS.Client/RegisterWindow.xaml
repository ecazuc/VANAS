<Window x:Class="VANAS.Client.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VANAS.Client"
        mc:Ignorable="d"
        Title="Create Account" Height="400" Width="350" 
        Background="#121212" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="30">
            <TextBlock Text="SIGN UP" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Foreground="Gray" Margin="0,10,0,5"/>
            <TextBox x:Name="txtUser" Height="35" Background="#1E1E1E" Foreground="White" BorderThickness="1" BorderBrush="#333" VerticalContentAlignment="Center" Padding="5,0"/>

            <TextBlock Text="Password" Foreground="Gray" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPass" Height="35" Background="#1E1E1E" Foreground="White" BorderThickness="1" BorderBrush="#333" VerticalContentAlignment="Center" Padding="5,0"/>

            <TextBlock Text="Confirm Password" Foreground="Gray" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtConfirmPass" Height="35" Background="#1E1E1E" Foreground="White" BorderThickness="1" BorderBrush="#333" VerticalContentAlignment="Center" Padding="5,0"/>

            <Button Content="REGISTER" Click="btnRegister_Click" Height="40" Margin="0,30,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold"/>

            <TextBlock Text="Back to Login" Foreground="Gray" HorizontalAlignment="Center" Margin="0,15,0,0" Cursor="Hand" MouseLeftButtonUp="BackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
