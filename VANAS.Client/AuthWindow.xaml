<Window x:Class="VANAS.Client.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Center Login" Height="1080" Width="1920" 
        WindowStyle="None" WindowStartupLocation="CenterScreen" 
        Background="#121212">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="GAMING CENTER" Foreground="White" FontSize="32" 
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Username" Foreground="Gray" Margin="0,10,0,5"/>
                <TextBox x:Name="txtUsername" Height="35" Background="#1E1E1E" 
                     Foreground="White" BorderBrush="#333" Padding="5,5,0,0"/>

                <TextBlock Text="Password" Foreground="Gray" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Background="#1E1E1E" 
                         Foreground="White" BorderBrush="#333" Padding="5,5,0,0"/>

                <Button x:Name="btnLogin" Content="LOGIN" Margin="0,30,0,0" Height="40" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" 
                    Click="btnLogin_Click"/>

            <TextBlock x:Name="linkSignUp" Text="Don't have an account? Sign up here." Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="linkSignUp_MouseLeftButtonUp"/>
            <TextBlock x:Name="linkForgotPassword" Text="Forgot Password ?" Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,5,0,0" Cursor="Hand" />
                
                <TextBlock x:Name="lblStatus" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
</Window>
