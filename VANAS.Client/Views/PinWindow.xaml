<Window x:Class="VANAS.Client.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VANAS" Width="380" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Padding="28">
        <StackPanel>
            <TextBlock Text="CODE ADMIN" Style="{StaticResource TitleText}" FontSize="26" HorizontalAlignment="Center"/>
            <TextBlock Text="Quitter le mode kiosque" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,2,0,10"/>
            <PasswordBox x:Name="txtPin" MaxLength="16"/>
            <TextBlock x:Name="lblError" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,10,0,0" MinHeight="18" TextWrapping="Wrap"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnOk" Content="VALIDER" IsDefault="True" Click="btnOk_Click"/>
                <Button Grid.Column="2" Content="ANNULER" IsCancel="True" Click="btnCancel_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
