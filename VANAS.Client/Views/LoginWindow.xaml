<Window x:Class="VANAS.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VANAS" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <TextBlock Text="VANAS // SYSTEM ONLINE" Style="{StaticResource LabelText}" Margin="32,28,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock x:Name="lblStation" Style="{StaticResource LabelText}" Margin="0,28,32,0"
                   HorizontalAlignment="Right" VerticalAlignment="Top"/>

        <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="VANAS" Style="{StaticResource TitleText}" FontSize="54" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblMode" Text="ACCÈS JOUEUR" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="IDENTIFIANT" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtUser" MaxLength="32"/>

                <TextBlock Text="MOT DE PASSE" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="txtPass"/>

                <StackPanel x:Name="panelConfirm" Visibility="Collapsed">
                    <TextBlock Text="CONFIRMER LE MOT DE PASSE" Style="{StaticResource LabelText}"/>
                    <PasswordBox x:Name="txtConfirm"/>
                    <TextBlock Text="DATE DE NAISSANCE (JJ/MM/AAAA)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtBirth" MaxLength="10"/>
                    <TextBlock Text="À partir de 12 ans. Avant 15 ans, l'accord d'un parent est nécessaire, à confirmer une fois au comptoir." Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock x:Name="lblStatus" TextWrapping="Wrap" FontSize="14" Margin="0,18,0,0" MinHeight="20"/>

                <Button x:Name="btnSubmit" Content="CONNEXION" Margin="0,12,0,0" IsDefault="True" Click="btnSubmit_Click"/>
                <Button x:Name="btnToggle" Content="Pas de compte ? Créer un compte" Style="{StaticResource LinkButton}"
                        Margin="0,16,0,0" Click="btnToggle_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
