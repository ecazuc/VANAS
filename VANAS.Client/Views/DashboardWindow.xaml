<Window x:Class="VANAS.Client.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VANAS.Client.Controls"
        Title="VANAS" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Padding="32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AvatarBadge x:Name="avatarSmall" Width="52" Height="52" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JOUEUR" Style="{StaticResource LabelText}" Margin="0"/>
                        <TextBlock x:Name="lblUser" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                    <TextBlock Text="TEMPS RESTANT" Style="{StaticResource LabelText}" Margin="0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTime" Text="00:00:00" Style="{StaticResource TitleText}" FontSize="48" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="barTime" Height="5" Minimum="0" Maximum="1" Value="1" Margin="0,4,0,0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblNet" Text="● EN LIGNE" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{StaticResource OkBrush}"/>
                    <Button Content="DÉCONNEXION" Margin="0,8,0,0" Padding="0" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Time warning banner -->
        <Border x:Name="bannerWarning" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource DangerBrush}" Padding="32,10">
            <TextBlock x:Name="lblWarning" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BgBrush}" HorizontalAlignment="Center"/>
        </Border>

        <!-- Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="32,18,32,0">
            <StackPanel Margin="0,0,28,0">
                <Button x:Name="tabGames" Content="JEUX" Style="{StaticResource LinkButton}" FontSize="20" Click="tabGames_Click"/>
                <Rectangle x:Name="underGames" Height="3" Margin="0,4,0,0" Fill="{StaticResource AccentBrush}"/>
            </StackPanel>
            <StackPanel>
                <Button x:Name="tabProfile" Content="PROFIL" Style="{StaticResource LinkButton}" FontSize="20" Click="tabProfile_Click"/>
                <Rectangle x:Name="underProfile" Height="3" Margin="0,4,0,0" Fill="{StaticResource AccentBrush}" Visibility="Hidden"/>
            </StackPanel>
        </StackPanel>

        <!-- Games (placeholder until PC-4: real detection of installed games) -->
        <ScrollViewer x:Name="panelGames" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <TextBlock Text="LANCEURS" Style="{StaticResource TitleText}" FontSize="22" Margin="0,0,0,20"/>
                <ItemsControl x:Name="listLaunchers">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Style="{StaticResource GameTile}" Click="Launcher_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Profile -->
        <ScrollViewer x:Name="panelProfile" Grid.Row="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                <TextBlock Text="MON PROFIL" Style="{StaticResource TitleText}" FontSize="22"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <controls:AvatarBadge x:Name="avatarBig" Width="110" Height="110" VerticalAlignment="Top"/>
                    <StackPanel Margin="28,0,0,0" Width="420">
                        <TextBlock Text="PSEUDO" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPseudo" MaxLength="24"/>
                        <TextBlock Text="AVATAR" Style="{StaticResource LabelText}"/>
                        <ItemsControl x:Name="listAvatars">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Key}" Width="38" Height="38" Margin="0,0,10,10" Click="AvatarChoice_Click" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{Binding Brush}" Stroke="{StaticResource TextBrush}" StrokeThickness="0"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="lblProfileStatus" FontSize="14" TextWrapping="Wrap" MinHeight="20" Margin="0,6,0,0"/>
                        <Button Content="ENREGISTRER" HorizontalAlignment="Left" Margin="0,8,0,0" Click="btnSaveProfile_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,16,0" MinWidth="180">
                        <StackPanel>
                            <TextBlock Text="TEMPS JOUÉ" Style="{StaticResource LabelText}" Margin="0"/>
                            <TextBlock x:Name="statPlayed" Text="-" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,16,0" MinWidth="140">
                        <StackPanel>
                            <TextBlock Text="SESSIONS" Style="{StaticResource LabelText}" Margin="0"/>
                            <TextBlock x:Name="statSessions" Text="-" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,14" MinWidth="180">
                        <StackPanel>
                            <TextBlock Text="MEMBRE DEPUIS" Style="{StaticResource LabelText}" Margin="0"/>
                            <TextBlock x:Name="statSince" Text="-" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="DERNIÈRES SESSIONS" Style="{StaticResource TitleText}" FontSize="18" Margin="0,32,0,10"/>
                <TextBlock x:Name="lblNoHistory" Text="Aucune session pour l'instant." Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                <ItemsControl x:Name="listHistory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Station}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
