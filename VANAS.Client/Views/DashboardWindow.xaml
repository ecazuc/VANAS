<Window x:Class="VANAS.Client.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VANAS" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Padding="32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="JOUEUR" Style="{StaticResource LabelText}" Margin="0"/>
                    <TextBlock x:Name="lblUser" FontSize="26" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                    <TextBlock Text="TEMPS RESTANT" Style="{StaticResource LabelText}" Margin="0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTime" Text="00:00:00" Style="{StaticResource TitleText}" FontSize="48" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="barTime" Height="5" Minimum="0" Maximum="1" Value="1" Margin="0,4,0,0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblNet" Text="● EN LIGNE" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{StaticResource OkBrush}"/>
                    <Button Content="DÉCONNEXION" Margin="0,8,0,0" Padding="0" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Library (placeholder until PC-4: real detection of installed games) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <TextBlock Text="LANCEURS" Style="{StaticResource TitleText}" FontSize="22" Margin="0,0,0,20"/>
                <ItemsControl x:Name="listLaunchers">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Style="{StaticResource GameTile}" Click="Launcher_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
